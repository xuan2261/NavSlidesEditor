{
  "schemaVersion": "1",
  "policyVersion": "release-target-policy-v4",
  "receiptSchemaVersion": "release-receipt-v1",
  "targets": {
    "linux-ci": {
      "selected": true,
      "requiredGates": [
        "client-manifest",
        "unit-coverage",
        "playwright",
        "load",
        "docker",
        "supply-chain",
        "attestation"
      ]
    },
    "windows": {
      "selected": true,
      "publicArtifacts": ["nsis-exe", "portable-exe"],
      "requiredGates": [
        "electron-runtime-closure",
        "officecli-physical",
        "fidelity-powerpoint",
        "attestation"
      ],
      "signingGates": {
        "signed": ["authenticode", "post-download-authenticode"],
        "unsigned": ["authenticode-unsigned"]
      }
    },
    "linux-desktop": {
      "selected": false,
      "unselectedReceiptStatus": "not-selected",
      "requiredGates": []
    },
    "macos-desktop": {
      "selected": false,
      "unselectedReceiptStatus": "not-selected",
      "requiredGates": []
    }
  },
  "authenticode": {
    "mode": "optional",
    "signingEnvVars": [
      "WINDOWS_SIGNING_SCRIPT",
      "WINDOWS_SIGNING_SUBJECT",
      "WINDOWS_SIGNING_THUMBPRINT",
      "RFC3161_TIMESTAMP_URL"
    ],
    "unsignedMode": "authenticode-unsigned",
    "publisherSubjectSource": "protected-environment:WINDOWS_SIGNING_SUBJECT",
    "publisherThumbprintSource": "protected-environment:WINDOWS_SIGNING_THUMBPRINT",
    "requireRfc3161Timestamp": true,
    "requirePostDownloadVerification": true,
    "unsignedReleaseDisclosure": "**Unsigned Windows build (`authenticode-unsigned`):** Windows NSIS installer and portable executables in this release are NOT Authenticode-signed because `WINDOWS_SIGNING_*` credentials were not configured. Windows SmartScreen and Defender will show an unknown-publisher warning; verify SHA-256 checksums and GitHub Actions SLSA provenance (`gh attestation verify`) before running."
  },
  "containerSecurityAdvisory": {
    "mode": "user-risk-accepted",
    "decisionDate": "2026-09-27",
    "scope": "single-user-private-self-hosted",
    "requiredEvidence": [
      "container-trivy.json",
      "container-sbom.spdx.json",
      "container-supply-chain-receipt.json"
    ],
    "securityPassClaim": false
  },
  "attestations": {
    "issuer": "https://token.actions.githubusercontent.com",
    "requireWorkflowIdentity": true,
    "requiredArtifacts": ["client-dist", "docker-image", "electron-windows"]
  }
}
